# EduGrade — Variáveis de Ambiente
# Copie este arquivo para .env e configure os valores antes de iniciar o servidor
# Windows CMD: copy .env.example .env
# Linux/macOS: cp .env.example .env

# ─────────────────────────────────────────
# Aplicação
# ─────────────────────────────────────────
APP_NAME=EduGrade
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# ─────────────────────────────────────────
# Servidor
# ─────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ─────────────────────────────────────────
# Banco de Dados
# ─────────────────────────────────────────
# SQLite (padrão para desenvolvimento — sem instalação extra)
DATABASE_URL=sqlite:///./backend/edugrade.db

# PostgreSQL (para produção):
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/edugrade

# ─────────────────────────────────────────
# Segurança e Autenticação
# ─────────────────────────────────────────
# Gere uma chave segura com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=sua-chave-super-secreta-mude-em-producao-minimo-32-caracteres

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Algoritmo de hash de senhas (use "argon2" — não "argon2id")
PASSWORD_HASH_ALGORITHM=argon2

# ─────────────────────────────────────────
# CORS (Origens permitidas)
# ─────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "http://127.0.0.1:8000"]

# ─────────────────────────────────────────
# Envio de Arquivos
# ─────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./storage/exams
PDF_DIR=./storage/exams/pdfs
QR_DIR=./storage/exams/qrcodes
PROCESSED_DIR=./storage/processed
TEMP_DIR=./storage/temp
MATERIAL_STORAGE_DIR=./storage/materials
ALLOWED_EXTENSIONS=[".pdf", ".jpg", ".jpeg", ".png"]

# ─────────────────────────────────────────
# Provedores de Inteligência Artificial
# ─────────────────────────────────────────
# Opções: mock (testes), ollama (local), openai, anthropic
AI_PROVIDER=mock

# Ollama (IA local gratuita — https://ollama.ai/)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=llama3.1
OLLAMA_MULTIMODAL_MODEL=llava

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=3

# Chave mestra Fernet para credenciais salvas pelo painel administrativo.
# Gere uma chave aleatória conforme docs/SEGURANCA_CREDENCIAIS.md.
CREDENTIAL_ENCRYPTION_KEY=

# API administrativa local do Free Claude Code (FCC).
FCC_BASE_URL=http://127.0.0.1:8082

# ─────────────────────────────────────────
# OCR (Reconhecimento de Texto)
# ─────────────────────────────────────────
# Opções: tesseract, paddleocr
OCR_ENGINE=tesseract

# Caminho do executável Tesseract (Windows: C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_PATH=tesseract

# Idioma do PaddleOCR
PADDLEOCR_LANG=pt

# ─────────────────────────────────────────
# E-mail / SMTP (opcional)
# ─────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@edugrade.com

# ─────────────────────────────────────────
# Logs
# ─────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/edugrade.log

# ─────────────────────────────────────────
# Backup
# ─────────────────────────────────────────
BACKUP_DIR=./storage/backups
BACKUP_RETENTION_DAYS=30
